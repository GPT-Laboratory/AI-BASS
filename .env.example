# Copy to .env. Never commit .env or real credentials.
# Required: provide unique values before running Docker Compose.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=
EMAIL_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
MONGOT_PASSWORD=

# Azure OpenAI resource endpoint and key (required).
# Example endpoint format: https://your-resource.openai.azure.com/
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_VERSION=2024-12-01-preview
# These values must match deployment names in your Azure resource.
AZURE_LLM_MODEL=gpt-4o
AZURE_EMBED_MODEL=text-embedding-3-small

# Public browser URLs used in chat command replies.
ADMIN_PUBLIC_URL=http://localhost:8080
CHAT_PUBLIC_URL=http://localhost:8000
# Optional test-client user: use a user that exists in your local database.
TEST_CLIENT_USER=

# Optional Google Drive / Gmail integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Optional OneDrive / Microsoft email integration.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback

# Optional WhatsApp integration; enable the whatsapp Compose profile.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_VERIFY_TOKEN=

# Optional forwarding to another AI-BASS chat deployment.
# Set the same secret on the receiving chat deployment.
COURSE_URL=
COURSE_API_SECRET=

# Optional OpenAI key used only by the standalone smoke-test runner.
OPENAI_API_KEY=
